---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Support · Superchat" description="Get help with the Superchat app and self-hosted Superchat.">
  <div class="container">
    <Header />
    <main id="main" class="privacy-copy">
      <h1>Superchat support</h1>
      <p>
        For help with the Superchat mobile app or a hosted Superchat account, email{" "}
        <a href="mailto:hello@superchat.example">hello@superchat.example</a>. Include the email address on your
        account, what you expected to happen, and any error message you saw. Do not send passwords, API keys,
        access tokens, or other secrets.
      </p>
      <h2>Self-hosted Superchat</h2>
      <p>
        For self-hosting setup help or to report a bug or feature request, email{" "}
        <a href="mailto:hello@superchat.example">hello@superchat.example</a>.
      </p>
      <h2>Account deletion</h2>
      <p>
        In the mobile app, open <strong>Account</strong>, enter your current password under{" "}
        <strong>Delete account</strong>, and confirm. This permanently deletes the hosted account and its
        associated personal Space data.
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>
