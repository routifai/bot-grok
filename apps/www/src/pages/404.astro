---
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found · Nova" description="The requested Nova page does not exist.">
  <div class="container">
    <Header />
    <main id="main" class="privacy-copy">
      <h1>Page not found</h1>
      <p>The page you requested does not exist. Return home or get in touch with support.</p>
      <div class="cta-actions">
        <Button href="/">Home</Button>
        <Button href="/support/" variant="secondary">Contact support</Button>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
