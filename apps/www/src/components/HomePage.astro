---
import Button from "./Button.astro";
import Footer from "./Footer.astro";
import GetStartedDialog from "./GetStartedDialog.astro";
import Header from "./Header.astro";
import { ProductDemo } from "./ProductDemo";
import RosterBotAvatar from "./RosterBotAvatar.astro";
import { getHomeCopy } from "../i18n/home";
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_HTML_LANG,
  isLocale,
  localeHomePath,
  type Locale,
} from "../i18n/locales";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME, SITE_URL } from "../site";

const locale: Locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : DEFAULT_LOCALE;

const copy = getHomeCopy(locale);
const enCopy = getHomeCopy(DEFAULT_LOCALE);
const availableLanguages = LOCALES.map((supportedLocale) =>
  getHomeCopy(supportedLocale).availableLanguage
);
const homeHref = localeHomePath(locale);
const pageUrl = `${SITE_URL}${homeHref === "/" ? "/" : homeHref}`;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE_URL}/#organization`,
      name: SITE_NAME,
      url: `${SITE_URL}/`,
      logo: `${SITE_URL}/brand/nova-mark.svg`,
      email: "hello@nova.example",
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "customer support",
        email: "hello@nova.example",
        url: `${SITE_URL}/support/`,
        availableLanguage: availableLanguages,
      },
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: SITE_NAME,
      description: enCopy.description,
      inLanguage: LOCALE_HTML_LANG[DEFAULT_LOCALE],
      publisher: { "@id": `${SITE_URL}/#organization` },
    },
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: copy.title,
      description: copy.description,
      inLanguage: LOCALE_HTML_LANG[locale],
      isPartOf: { "@id": `${SITE_URL}/#website` },
      about: { "@id": `${SITE_URL}/#software` },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${SITE_URL}/#software`,
      name: SITE_NAME,
      url: `${SITE_URL}/`,
      description: enCopy.description,
      applicationCategory: "BusinessApplication",
      applicationSubCategory: "AI agent platform",
      operatingSystem: "Web, macOS, Linux, iOS, Android",
      provider: { "@id": `${SITE_URL}/#organization` },
      inLanguage: availableLanguages,
    },
  ],
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  {structuredData}
  locale={locale}
  skipLabel={copy.skipToContent}
  homeAlternates
  ogImageAlt={copy.ogImageAlt}
>
  <div class="container">
    <Header locale={locale} copy={copy.nav} homeHref={homeHref} />

    <main id="main">
      <GetStartedDialog copy={copy.getStartedDialog} waitlist={copy.waitlist} />

      <section class="hero">
        <a class="hero__pill" href="#selfhost">
          <span class="hero__badge">{copy.hero.badge}</span>
          <span>{copy.hero.pill}</span>
        </a>
        <h1>{copy.hero.heading}</h1>
        <p class="lead">
          {copy.hero.lead}
        </p>
        <div class="hero__actions">
          <button class="button button--primary" type="button" data-get-started-open>
            {copy.hero.getStarted}
          </button>
          <Button href="#demo" variant="secondary">{copy.hero.secondaryCta}</Button>
        </div>
      </section>

      <section id="demo">
        <ProductDemo locale={locale} client:load />
      </section>

      <section id="selfhost" class="section">
        <div class="section-intro">
          <div class="eyebrow">{copy.selfHost.eyebrow}</div>
          <h2 class="section-heading">{copy.selfHost.heading}</h2>
          <p class="section-copy">
            {copy.selfHost.copy}
          </p>
        </div>
        <div class="selfhost-cta">
          <button class="button button--primary" type="button" data-get-started-open>
            {copy.hero.getStarted}
          </button>
        </div>
        <div class="card-grid-3">
          {
            copy.selfHost.features.map((feature) => (
              <article class="feature-card">
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section id="roster" class="section">
        <div class="section-intro">
          <div class="eyebrow">{copy.roster.eyebrow}</div>
          <h2 class="section-heading">{copy.roster.heading}</h2>
          <p class="section-copy">
            {copy.roster.copy}
          </p>
        </div>
        <div class="card-grid-4">
          {
            copy.roster.bots.map((bot) => (
              <article class="roster-card">
                <RosterBotAvatar color={bot.color} name={bot.name} />
                <h3>{bot.name}</h3>
                <p>{bot.desc}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section id="deploy" class="section">
        <div class="section-intro">
          <div class="eyebrow">{copy.openSource.eyebrow}</div>
          <h2 class="section-heading">{copy.openSource.heading}</h2>
          <p class="section-copy">
            {copy.openSource.copy}
          </p>
        </div>
        <div class="comparison-grid">
          <article class="comparison-card">
            <h3>{copy.openSource.selfHostTitle}</h3>
            <p class="comparison-meta">{copy.openSource.selfHostMeta}</p>
            <div class="comparison-list">
              {copy.openSource.selfHostItems.map((item) => <div>{item}</div>)}
            </div>
            <div class="comparison-actions">
              <button class="button button--primary button--small" type="button" data-get-started-open>
                {copy.openSource.selfHostGetStarted}
              </button>
            </div>
          </article>
          <article class="comparison-card comparison-card--muted">
            <div class="comparison-kicker">
              <h3>{copy.openSource.cloudTitle}</h3>
              <span class="comparison-badge">{copy.openSource.cloudBadge}</span>
            </div>
            <p class="comparison-meta">{copy.openSource.cloudMeta}</p>
            <div class="comparison-list comparison-list--muted">
              {copy.openSource.cloudItems.map((item) => <div>{item}</div>)}
            </div>
            <div class="comparison-actions">
              <button class="button button--primary button--small" type="button" data-get-started-open>
                {copy.openSource.getStarted}
              </button>
            </div>
          </article>
        </div>
      </section>

      <section class="stats-band">
        <div>
          <h2>{copy.cta.heading}</h2>
          <p>{copy.cta.copy}</p>
          <div class="cta-actions">
            <button class="button button--primary" type="button" data-get-started-open>
              {copy.cta.getStarted}
            </button>
            <Button href="#demo" variant="secondary">{copy.cta.secondaryCta}</Button>
          </div>
        </div>
        <div class="stats-grid">
          {
            copy.cta.stats.map((stat) => (
              <div>
                <div class="stat-value">
                  {stat.value === "model"
                    ? "Any model"
                    : stat.value === "audit"
                      ? "Audit log"
                      : stat.value === "private"
                        ? copy.cta.privateValue
                        : copy.cta.selfHostValue}
                </div>
                <div class="stat-label">{stat.label}</div>
              </div>
            ))
          }
        </div>
      </section>
    </main>

    <Footer
      locale={locale}
      languagesLabel={copy.footer.languagesLabel}
      navLabel={copy.footer.navLabel}
      homeLabel={copy.nav.home}
      linkLabels={copy.footer.links}
      homeHref={homeHref}
    />
  </div>
</BaseLayout>
