# Computers VPS settings. Copy to .env.computers (never commit it) and fill in every value.
# Used by: docker compose --env-file .env.computers -f infra/compose/docker-compose.computers.yml ...

# DNS name whose A record points at this VM; Caddy gets the HTTPS certificate for it.
COMPUTERS_HOST=computers.example.com

# Bearer token the engine (Railway) must send to the supervisor. Generate: openssl rand -hex 32
# Must equal OMNIGENT_COMPUTER_SUPERVISOR_TOKEN on the Railway engine service.
SANDBOX_SUPERVISOR_TOKEN=replace-with-openssl-rand-hex-32

# Group id of the Docker socket, so the supervisor (not root) may use it. Get it with:
#   stat -c %g /var/run/docker.sock
DOCKER_GID=999

# Image tag of the Computer desktop built by the stack.
NOVA_COMPUTER_IMAGE=nova/computer:local

# Per-Computer ceilings ("0", "none" or "unlimited" removes one). Size so
# (number of friends) x memory fits the VM with headroom for Docker itself.
NOVA_COMPUTER_MEMORY=2g
NOVA_COMPUTER_CPUS=2
NOVA_COMPUTER_PIDS_LIMIT=2048

# Longest a single command in a Computer may run, in milliseconds.
SANDBOX_COMMAND_TIMEOUT_MS=300000

# Cap on simultaneous Computers per space (0 = unlimited).
SANDBOX_MAX_COMPUTERS_PER_SPACE=0

LOG_LEVEL=info
