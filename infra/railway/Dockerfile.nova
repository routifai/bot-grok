# syntax=docker/dockerfile:1.7
# Railway copy of infra/compose/Dockerfile (keep in step with it). Differences: no BuildKit
# cache mount (Railway only accepts cache ids prefixed with the service id) and no USER node
# (the /data volume is root-owned). Used by the combined API + worker service.
# One image for the api, worker and web services (Compose runs each with its own command).
# Only those three apps and the packages they use are installed: the desktop, mobile and marketing
# workspaces keep just their manifests so the lockfile matches.
FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5

ENV PNPM_HOME=/pnpm \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    ELECTRON_SKIP_BINARY_DOWNLOAD=1 \
    CI=1
# Prisma needs OpenSSL at runtime; CA certificates for HTTPS to model and integration providers.
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /app

# Normalize modes: a restrictive host umask (e.g. 077 on hardened hosts) would otherwise
# leave the copied tree unreadable to USER node at runtime.
COPY --chmod=755 . .

# The pnpm store lives in a build cache, so it speeds up rebuilds without landing in the image.
RUN pnpm install --frozen-lockfile --store-dir /pnpm/store --package-import-method copy \
      --filter "@aiden/api..." --filter "@aiden/worker..." --filter "@aiden/web..."
RUN pnpm --filter @aiden/db generate
RUN AIDEN_ALLOW_DEV_SECRETS=1 pnpm --filter @aiden/web build
RUN install -d -m 750 -o node -g node /data /app/apps/web/node_modules/.vite-temp

ARG GIT_SHA
ENV NODE_ENV=production
ENV GIT_SHA=$GIT_SHA
EXPOSE 3100 5173 7091
# No USER node: a Railway volume mounts root-owned, and /data must be writable.
# API + worker + web in one container (see start-nova.sh).
CMD ["bash", "infra/railway/start-nova.sh"]
