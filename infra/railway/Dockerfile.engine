# syntax=docker/dockerfile:1.7
# Omnigent engine for Railway. Build context is the REPO ROOT (Railway: root directory "/"),
# because the image needs both engine/omnigent (the engine, incl. the "computer" sandbox
# launcher) and infra/omnigent/agents (the rendered superchat-claude bundle).
# The server stages mirror engine/omnigent/deploy/docker/Dockerfile (server target) with
# `engine/omnigent/` path prefixes; keep them in step when that file changes.
# Bases and package sources are build args with public defaults; a company sets its own registry
# and mirrors in .env (see .env.docker.example). Python is Ubuntu 24.04's own 3.12.
ARG BASE_IMAGE=ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
ARG NODE_IMAGE=node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392

# Builds the bundled web UI only; nothing from this stage but its output reaches the image.
FROM ${NODE_IMAGE} AS web-builder
ARG NPM_CONFIG_REGISTRY=https://registry.npmjs.org
WORKDIR /web
COPY engine/omnigent/pnpm-workspace.yaml engine/omnigent/pnpm-lock.yaml ./
COPY engine/omnigent/web/package.json ./web/
COPY engine/omnigent/web/electron/package.json ./web/electron/
RUN npm install -g pnpm@11.15.1
RUN pnpm install --frozen-lockfile --filter web
COPY engine/omnigent/web/ ./web/
RUN pnpm --filter web run build

# APT_MIRROR empty keeps Ubuntu's public sources; set, it replaces every URIs: line.
FROM ${BASE_IMAGE} AS ubuntu
ARG APT_MIRROR=
ENV DEBIAN_FRONTEND=noninteractive
RUN if [ -n "${APT_MIRROR}" ]; then \
      sed -i "s|^URIs: .*|URIs: ${APT_MIRROR}|" /etc/apt/sources.list.d/ubuntu.sources; \
    fi

FROM ubuntu AS builder
ARG PYPI_INDEX_URL=https://pypi.org/simple
ENV PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=${PYPI_INDEX_URL} UV_DEFAULT_INDEX=${PYPI_INDEX_URL}
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential ca-certificates python3 python3-dev python3-venv \
 && rm -rf /var/lib/apt/lists/*
# uv in its own venv, so it stays out of /opt/venv (the runtime copies that whole).
RUN python3 -m venv /opt/uv && /opt/uv/bin/pip install --no-cache-dir uv \
 && ln -s /opt/uv/bin/uv /usr/local/bin/uv
WORKDIR /build
COPY engine/omnigent/pyproject.toml engine/omnigent/setup.py ./
COPY engine/omnigent/LICENSE engine/omnigent/NOTICE ./
COPY engine/omnigent/sdks/ ./sdks/
COPY engine/omnigent/omnigent/ ./omnigent/
COPY engine/omnigent/examples/ ./examples/
RUN python3 -m venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv PATH="/opt/venv/bin:${PATH}"
RUN uv pip install --no-cache-dir -e .

FROM builder AS server-builder
COPY --from=web-builder /web/omnigent/server/static/web-ui ./omnigent/server/static/web-ui
RUN test -f ./omnigent/server/static/web-ui/index.html
RUN uv pip install --no-cache-dir 'psycopg[binary]>=3.1,<4'
# `memory` = the long-term memory tools the Muse uses.
ARG OMNIGENT_EXTRAS=memory
RUN if [ -n "${OMNIGENT_EXTRAS}" ]; then uv pip install --no-cache-dir -e ".[${OMNIGENT_EXTRAS}]"; fi

# Same Ubuntu base as the builder: /opt/venv's bin/python links to /usr/bin/python3.12.
FROM ubuntu AS runtime
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PATH="/opt/venv/bin:${PATH}"
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates python3 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=server-builder /opt/venv /opt/venv
COPY --from=server-builder /build /build
COPY engine/omnigent/deploy/docker/entrypoint.py /app/entrypoint.py
# Superchat additions: the agent bundle(s), the config template and the start wrapper.
COPY infra/omnigent/agents /opt/superchat/agents
COPY infra/railway/engine.config.yaml.tmpl /opt/superchat/config.yaml.tmpl
COPY infra/railway/engine.config.litellm.yaml.tmpl /opt/superchat/config.litellm.yaml.tmpl
COPY --chmod=755 infra/railway/engine-start.sh /opt/superchat/engine-start.sh
WORKDIR /app
RUN mkdir -p /data/artifacts

# Non-secret defaults. Anything here can be overridden with a Railway service variable.
ENV PORT=8000 \
    ARTIFACT_DIR=/data/artifacts \
    OMNIGENT_DATA_DIR=/data \
    OMNIGENT_CONFIG_HOME=/data/config \
    OMNIGENT_DISABLE_KEYRING=1 \
    OMNIGENT_BUILTIN_AGENT_DIRS=/opt/superchat/agents/superchat-claude:/opt/superchat/agents/superchat-pi \
    OMNIGENT_AUTH_PROVIDER=header \
    OMNIGENT_AUTH_TENANT_HEADER=X-Omnigent-Tenant \
    OMNIGENT_SUPERCHAT_DEFAULT_AGENT=superchat-claude \
    OMNIGENT_SUPERCHAT_SANDBOX_PROVIDER=computer \
    OMNIGENT_COMPUTER_HOME_ROOT=/data \
    OMNIGENT_ADMIN_LIST_PATH=/data/admins \
    OMNIGENT_QUIET_MOMENT_MIN_GAP_SECONDS=21600 \
    OMNIGENT_BROWSER_BACKEND=local \
    OMNIGENT_PROACTIVE_PROVISION=1 \
    SUPERCHAT_CLAUDE_MODEL=claude-sonnet-5-5 \
    OMNIGENT_HELPER_MODEL_FAST=claude-haiku-4-5

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${PORT}/health" || exit 1
CMD ["/opt/superchat/engine-start.sh"]
