+// Nova patch: native chart hook ---------------------------------------------------------------
+// The page puts a PptxGenJS chart spec on a <canvas data-pptx-chart>:
+//   { "types": [{ "type": "bar", "data": [...], "options": {...} }, ...], "options": {...} }
+// One entry in `types` is a single chart, several are a combo chart (PptxGenJS addChart with a
+// type array). `type` is a PptxGenJS chart type (bar, line, area, pie, doughnut, radar, scatter,
+// bubble); `data` and `options` are exactly what pptx.addChart takes. Lengths that are CSS pixels
+// on the page (font sizes, line widths, marker sizes) come as px and are converted to points at
+// the slide scale here, because only this function knows the scale.
+const CHART_PX_KEYS = /FontSize$|^lineSize$|^lineDataSymbolSize$|^size$/;
+
+function readChartSpec(node) {
+  let spec;
+  try {
+    spec = JSON.parse(node.getAttribute('data-pptx-chart'));
+  } catch (e) {
+    throw new Error(`data-pptx-chart is not valid JSON: ${e.message}`);
+  }
+  if (!spec || !Array.isArray(spec.types) || spec.types.length === 0) {
+    throw new Error('data-pptx-chart needs a non-empty "types" array');
+  }
+  return spec;
+}
+
+function scaleChartPx(value, scale) {
+  if (Array.isArray(value)) return value.map((entry) => scaleChartPx(entry, scale));
+  if (!value || typeof value !== 'object') return value;
+  const out = {};
+  for (const [key, entry] of Object.entries(value)) {
+    out[key] =
+      CHART_PX_KEYS.test(key) && typeof entry === 'number'
+        ? Math.max(0.25, Math.round(entry * 0.75 * scale * 100) / 100)
+        : scaleChartPx(entry, scale);
+  }
+  return out;
+}
+
+function addNativeChart(slide, pptx, item, scale) {
+  const known = new Set(Object.values(pptx.charts));
+  const types = item.chartSpec.types.map((entry) => {
+    if (!known.has(entry.type)) throw new Error(`data-pptx-chart: unknown chart type "${entry.type}"`);
+    return { type: entry.type, data: entry.data, options: scaleChartPx(entry.options || {}, scale) };
+  });
+  const options = {
+    ...scaleChartPx(item.chartSpec.options || {}, scale),
+    x: item.options.x,
+    y: item.options.y,
+    w: item.options.w,
+    h: item.options.h,
+    altText: item.options.altText,
+    objectName: item.options.objectName,
+  };
+  if (types.length === 1) {
+    slide.addChart(types[0].type, types[0].data, { ...types[0].options, ...options });
+  } else {
+    slide.addChart(types, options);
+  }
+}
