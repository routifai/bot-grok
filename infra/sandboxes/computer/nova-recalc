#!/usr/bin/env python3
"""Recalculate an .xlsx in place with headless LibreOffice so formula cells carry real values.

Usage: nova-recalc [--timeout SECONDS] FILE.xlsx

LibreOffice loads the workbook (forced to recalculate every formula), saves it as xlsx in a
temp directory next to the file, and the result atomically replaces FILE. Exit 0 on success,
1 on failure (the original file is left untouched), 127 when LibreOffice is not installed.
"""

import argparse
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

# Calc > Formula > Recalculation on File Load > Excel 2007 and newer: 0 = always.
_PROFILE = """<?xml version="1.0" encoding="UTF-8"?>
<oor:items xmlns:oor="http://openoffice.org/2001/registry" \
xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
<item oor:path="/org.openoffice.Office.Calc/Formula/Load">\
<prop oor:name="OOXMLRecalcMode" oor:op="fuse"><value>0</value></prop></item>
</oor:items>
"""


def recalc(path: Path, timeout: float) -> int:
    soffice = shutil.which("soffice") or shutil.which("libreoffice")
    if soffice is None:
        print("nova-recalc: LibreOffice (soffice) is not installed", file=sys.stderr)
        return 127
    if path.suffix.lower() != ".xlsx" or not path.is_file():
        print(f"nova-recalc: not an .xlsx file: {path}", file=sys.stderr)
        return 1
    with tempfile.TemporaryDirectory(prefix="nova-recalc-") as tmp:
        profile = Path(tmp) / "profile"
        (profile / "user").mkdir(parents=True)
        (profile / "user" / "registrymodifications.xcu").write_text(_PROFILE)
        out_dir = Path(tmp) / "out"
        out_dir.mkdir()
        # Copy in under a plain name: odd characters in the original name must not reach soffice.
        src = Path(tmp) / "in.xlsx"
        shutil.copyfile(path, src)
        cmd = [
            soffice,
            f"-env:UserInstallation={profile.as_uri()}",
            "--headless",
            "--norestore",
            "--nologo",
            "--convert-to",
            "xlsx:Calc MS Excel 2007 XML",
            "--outdir",
            str(out_dir),
            str(src),
        ]
        try:
            done = subprocess.run(
                cmd, capture_output=True, text=True, timeout=timeout, env={**os.environ, "HOME": tmp}
            )
        except subprocess.TimeoutExpired:
            print(f"nova-recalc: timed out after {timeout:g}s", file=sys.stderr)
            return 1
        result = out_dir / "in.xlsx"
        if done.returncode != 0 or not result.is_file() or result.stat().st_size == 0:
            print(f"nova-recalc: conversion failed: {done.stderr.strip()[:300]}", file=sys.stderr)
            return 1
        staged = path.with_name(f".{path.name}.recalc-tmp")
        try:
            shutil.copyfile(result, staged)
            os.chmod(staged, path.stat().st_mode & 0o777)
            os.replace(staged, path)
        finally:
            staged.unlink(missing_ok=True)
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Recalculate an .xlsx in place (LibreOffice).")
    parser.add_argument("file", type=Path)
    parser.add_argument("--timeout", type=float, default=90.0)
    args = parser.parse_args()
    return recalc(args.file, args.timeout)


if __name__ == "__main__":
    sys.exit(main())
