# PPTX (deck-capture.ts renderDeckSlides editable path + renderEditablePptx)
# ---------------------------------------------------------------------------------------------


def fetch_google_font_stylesheets(urls: list[str]) -> list[dict[str, str]]:
    """deck-capture.ts `fetchGoogleFontStylesheets`: TTF-flavoured CSS, bounded, best effort."""
    sheets: list[dict[str, str]] = []
    for url in urls:
        try:
            if urlsplit(url).hostname != "fonts.googleapis.com":
                continue
            # A generic UA makes Google Fonts return complete TTF faces. Chromium's WOFF2 subsets
            # are less reliable in the vendored PowerPoint converter.
            request = urllib.request.Request(url, headers={"user-agent": "Mozilla/5.0"})
            with urllib.request.urlopen(request, timeout=GOOGLE_FONT_STYLESHEET_TIMEOUT_S) as resp:
                sheets.append({"cssText": resp.read().decode("utf-8", "replace"), "url": url})
        except Exception:  # noqa: BLE001 - the page-side fetch remains the fallback
            continue
    return sheets


# A deck embeds its fonts as @font-face data URIs (the viewer's CSP blocks remote fonts), which
# dom-to-pptx's own scanner skips. Open Design hands imported font faces to the converter through
# an `@import` plus a stylesheet override (see `runDomToPptx` / `exposeImportedFontFaces`); the
# deck's embedded faces take exactly that path, so PowerPoint receives the font files too.
EMBEDDED_FONTS_URL = "data:text/css,/*nova-embedded-fonts*/"


def expose_embedded_fonts(browser: Chromium) -> list[dict[str, str]]:
    css = browser.evaluate(
        "Array.from(document.querySelectorAll('style[data-nova-fonts]'))"
        ".map((s) => s.textContent || '').join('\\n')"
    )
    if not isinstance(css, str) or "@font-face" not in css:
        return []
    browser.evaluate(
        "(() => { const s = document.createElement('style'); s.setAttribute('data-nova-export-fonts', '');"
        f" s.textContent = '@import url(\"{EMBEDDED_FONTS_URL}\");'; document.head.appendChild(s); return true; }})()"
    )
    return [{"cssText": css, "url": EMBEDDED_FONTS_URL}]


def measure_stage(browser: Chromium, slide_selector: str, stage_selector: str) -> tuple[int, int]:
    """Measure the deck's authored slide size; fall back to 1920x1080 (measureSlideStage)."""
    try:
        measured = browser.call_page("measureSlide", slide_selector, stage_selector)
    except ExportError:
        measured = None
    if isinstance(measured, dict):
        w, h = measured.get("w"), measured.get("h")
        if (
            isinstance(w, (int, float))
            and isinstance(h, (int, float))
            and SLIDE_MIN_PX <= w <= SLIDE_MAX_PX
            and SLIDE_MIN_PX <= h <= SLIDE_MAX_PX
        ):
            return round(w), round(h)
    return SLIDE_W, SLIDE_H


def capture_layered_backgrounds(browser: Chromium, slide_selector: str) -> dict[str, Any]:
    """deck-capture.ts `captureEditablePptxLayeredBackgrounds` over CDP."""
    targets = browser.call_page("collectLayeredPptxBackgroundTargets", slide_selector)
    if not targets:
        return {}
    # CDP multiplies clip.scale by the device scale factor. Keep the layer at a stable 2 physical
    # pixels per CSS pixel instead of double-scaling.
    dpr = float(browser.evaluate("window.devicePixelRatio") or 1)
    capture_scale = min(2.0, 2.0 / dpr)
    captures: dict[str, Any] = {}
    try:
        browser.send(
            "Emulation.setDefaultBackgroundColorOverride", {"color": {"r": 0, "g": 0, "b": 0, "a": 0}}
        )
        for target in targets:
            geometry = browser.evaluate(
                "(() => window.__novaDeck.isolateLayeredPptxBackground("
                f"{json.dumps(slide_selector)}, {json.dumps(target['id'])}))()"
            )
            if not geometry:
                raise ExportError(f"could not isolate layered PPTX background {target['id']}")
            browser.next_frames()
            data = ""
            for attempt in range(LAYERED_CAPTURE_ATTEMPTS):
                shot = browser.send(
                    "Page.captureScreenshot",
                    {
                        "captureBeyondViewport": True,
                        "clip": {
                            "height": geometry["height"],
                            "scale": capture_scale,
                            "width": geometry["width"],
                            "x": geometry["pageX"],
                            "y": geometry["pageY"],
                        },
                        "format": "png",
                        "fromSurface": True,
                    },
                    timeout_s=120,
                )
                data = shot.get("data") or ""
                if not data:
                    raise ExportError(f"Chromium returned no layered PPTX capture for {target['id']}")
                if browser.call_page("pngHasPaint", data):
                    break
                if attempt < LAYERED_CAPTURE_ATTEMPTS - 1:
                    browser.next_frames()
            else:
                raise ExportError(f"transparent chromium capture: {target['id']}")
            captures[target["id"]] = {
                "dataUrl": f"data:image/png;base64,{data}",
                "height": geometry["height"],
                "left": geometry["left"],
                "slideIndex": geometry["slideIndex"],
                "top": geometry["top"],
                "width": geometry["width"],
            }
            browser.call_page("restoreLayeredPptxBackgroundIsolation")
    finally:
        try:
            browser.call_page("restoreLayeredPptxBackgroundIsolation")
        except Exception:  # noqa: BLE001
            pass
        try:
            browser.send("Emulation.setDefaultBackgroundColorOverride")
        except Exception:  # noqa: BLE001
            pass
    return captures


def export_pptx(browser: Chromium, out: Path) -> dict[str, Any]:
    sel, stage_sel = json.loads(json.dumps([SLIDE_SELECTOR, DECK_STAGE_SELECTOR]))
    count = browser.call_page("countRealSlides", sel)
    if not isinstance(count, int) or count < 1:
        raise ExportError("no slide surfaces found in this deck", "NO_SLIDES")
    # Deck-only DOM prep: hide presenter chrome, authored 1:1 size, frozen animations.
    browser.call_page("prepareDeckStage", HIDE_CHROME_SELECTOR, stage_sel)
    width, height = measure_stage(browser, sel, stage_sel)
    browser.set_viewport(width, height)
    browser.next_frames()
    browser.call_page("pinDeckStage", width, height, stage_sel)

    # dom-to-pptx measures each element's live layout, so all slides must be laid out at once.
    browser.call_page("showAllSlides", sel)
    browser.next_frames()
    # Charts drawn while their slide was hidden have no size yet: lay them out before measuring.
    browser.call_page("resizeCharts")
    browser.next_frames()
    embedded_fonts = expose_embedded_fonts(browser)
    imported = browser.call_page("collectImportedStylesheetUrls")
    overrides = embedded_fonts + fetch_google_font_stylesheets(imported or [])
    browser.evaluate(read_bundle(), timeout_s=120)
    prepared = browser.call_page("runDomToPptx", sel, {}, "prepare", overrides, timeout_s=120)
    if not isinstance(prepared, dict) or not prepared.get("prepared") or prepared.get("error"):
        message = prepared.get("error") if isinstance(prepared, dict) else None
        raise ExportError(message or "editable PPTX export DOM normalization failed")
    browser.next_frames()
    layered = capture_layered_backgrounds(browser, sel)
    result = browser.call_page(
        "runDomToPptx", sel, layered, "export-prepared", overrides, timeout_s=300
    )
    if not isinstance(result, dict) or result.get("error") or not result.get("b64"):
        message = result.get("error") if isinstance(result, dict) else None
        raise ExportError(message or "editable PPTX export produced no output")
    out.write_bytes(base64.b64decode(result["b64"]))
    return {"slides": count, "width": width, "height": height}


# ---------------------------------------------------------------------------------------------
# PDF (pdf-export.ts exportPdfFromHtml, deck branch)
# ---------------------------------------------------------------------------------------------


def export_pdf(browser: Chromium, out: Path) -> dict[str, Any]:
    count = browser.call_page("countRealSlides", SLIDE_SELECTOR)
    if not isinstance(count, int) or count < 1:
        raise ExportError("no slide surfaces found in this deck", "NO_SLIDES")
    # Marks every slide active so the deck's own `.slide.active` styling applies to all of them.
    browser.call_page("unhideDeckSlidesForPrint")
    # Chart.js canvases are laid out at the printed size and painted (animations are off in decks).
    browser.call_page("resizeCharts")
    browser.evaluate(
        "(() => { const s = document.createElement('style'); s.setAttribute('data-nova-deck-pdf', '');"
        f" s.textContent = window.__novaDeck.DECK_PRINT_CSS; document.head.appendChild(s); return true; }})()"
    )
    browser.next_frames()
    pdf = browser.send(
        "Page.printToPDF",
        {
            "printBackground": True,
            "preferCSSPageSize": True,
            "marginTop": 0,
            "marginBottom": 0,
            "marginLeft": 0,
            "marginRight": 0,
            "paperWidth": DECK_PAGE_INCHES[0],
            "paperHeight": DECK_PAGE_INCHES[1],
            "transferMode": "ReturnAsBase64",
        },
        timeout_s=240,
    )
    data = pdf.get("data")
    if not data:
        raise ExportError("Chromium returned no PDF")
    out.write_bytes(base64.b64decode(data))
    return {"slides": count, "width": SLIDE_W, "height": SLIDE_H}


SLIDE_SELECTOR = ".slide, [data-screen-label], .deck-slide, .ppt-slide"
DECK_STAGE_SELECTOR = "deck-stage, #deck-stage, .deck-stage"
HIDE_CHROME_SELECTOR = (
    ".progress-bar, .notes-overlay, aside.notes, .speaker-notes, .deck-nav, .deck-hint, .deck-counter"
)


# The footer rail starts here (slide-relative px): authored content stays above it.
FOOTER_RAIL_TOP = SLIDE_H - 168


def run_lint(browser: Chromium) -> dict[str, Any]:
    """Nova addition: measure the laid-out deck for what would not survive export 1:1."""
    count = browser.call_page("countRealSlides", SLIDE_SELECTOR)
    if not isinstance(count, int) or count < 1:
        raise ExportError("no slide surfaces found in this deck", "NO_SLIDES")
    browser.call_page("prepareDeckStage", HIDE_CHROME_SELECTOR, DECK_STAGE_SELECTOR)
    width, height = measure_stage(browser, SLIDE_SELECTOR, DECK_STAGE_SELECTOR)
    browser.set_viewport(width, height)
    browser.next_frames()
    browser.call_page("pinDeckStage", width, height, DECK_STAGE_SELECTOR)
    browser.call_page("showAllSlides", SLIDE_SELECTOR)
    browser.next_frames()
    issues = browser.call_page(
        "lintDeck", {"slideSelector": SLIDE_SELECTOR, "railTop": FOOTER_RAIL_TOP}
    )
    return {"ok": True, "slides": count, "width": width, "height": height, "issues": issues or []}


def run_export(fmt: str, html_path: Path, out: Path | None) -> dict[str, Any]:
    if not html_path.is_file():
        raise ExportError("the deck file is missing", "NO_INPUT")
    with Chromium() as browser:
        browser.set_viewport(SLIDE_W, SLIDE_H)
        browser.load_document(html_path)
        browser.wait_for_printable_content()
        # Nova decks fit their stage to the viewport with a scale transform; at export the stage
        # must stay at its authored size, so the deck's fit() honours this attribute.
        browser.evaluate(
            "(() => { document.documentElement.setAttribute('data-nova-export', '');"
            " window.dispatchEvent(new Event('resize')); return true; })()"
        )
        if fmt == "lint":
            return run_lint(browser)
        assert out is not None
        info = export_pptx(browser, out) if fmt == "pptx" else export_pdf(browser, out)
    assert out is not None
    if not out.is_file() or out.stat().st_size == 0:
        raise ExportError("the export produced an empty file")
    return {"ok": True, "path": str(out), **info}


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="nova-deck-export")
    parser.add_argument("--format", choices=["pptx", "pdf", "lint"], required=True)
    parser.add_argument("--html", required=True)
    parser.add_argument("--out")
    args = parser.parse_args(argv[1:])
    if args.format != "lint" and not args.out:
        parser.error("--out is required for pptx and pdf")
    budget = int(os.environ.get("NOVA_DECK_EXPORT_TIMEOUT", "170"))

    def on_alarm(_signum: int, _frame: Any) -> None:
        raise ExportError("the export took too long", "TIMEOUT")

    signal.signal(signal.SIGALRM, on_alarm)
    signal.alarm(budget)
    try:
        result = run_export(args.format, Path(args.html), Path(args.out) if args.out else None)
    except ExportError as exc:
        result = {"ok": False, "error": str(exc), "code": exc.code}
    except Exception as exc:  # noqa: BLE001
        result = {"ok": False, "error": f"export failed: {exc}", "code": "RENDER_FAILED"}
    finally:
        signal.alarm(0)
    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
