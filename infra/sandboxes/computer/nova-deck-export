#!/usr/bin/env python3
"""Export a Nova deck (an HTML file of 1920x1080 slides) to an editable PPTX or a vector PDF.

Usage: nova-deck-export --format pptx|pdf --html PATH --out PATH
       nova-deck-export --format lint --html PATH

Runs a separate headless Chromium on this computer over CDP (the same CdpClient as
``nova-page-browser``; the person's visible browser is never touched), then:

* pptx: the Open Design pipeline. Lay out every slide, inject the vendored dom-to-pptx bundle,
  run the ported deck-capture logic (font normalisation, layered backgrounds, imported fonts) and
  write the native PowerPoint shapes and text it produces. Nothing is a screenshot of a slide.
* pdf: print the same render with the deck's print CSS (``Page.printToPDF``), which stays vector.

* lint: measure the laid-out deck for what would not survive export one-to-one (content past the
  slide or in the footer band, clipped text, missing data-nova-id, unembedded fonts, ...).

Prints one JSON object as the last stdout line: ``{"ok": true, "path", "slides", "width",
"height"}`` (lint: ``{"ok": true, "slides", "issues": [...]}``) or ``{"ok": false, "error",
"code"}``. Exit code 0 either way.

Portions modified from nexu-io/open-design apps/desktop/src/main/deck-capture.ts@802708f and
apps/desktop/src/main/pdf-export.ts@802708f, Apache-2.0 (see /NOTICE). Changes: Electron's
BrowserWindow/debugger orchestration is replaced by CDP calls on a headless Chromium with the same
steps in the same order; the page-side functions live in ``deck-capture-page.js`` next to this
file; the image-per-slide modes are not ported (Nova never exports slide screenshots).
"""

from __future__ import annotations

import argparse
import base64
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import urllib.request
from pathlib import Path
from typing import Any
from urllib.parse import urlsplit

HERE = Path(__file__).resolve().parent

# The deck canvas when the authored size cannot be measured (deck-capture.ts SLIDE_W/H and bounds).
SLIDE_W = 1920
SLIDE_H = 1080
SLIDE_MIN_PX = 320
SLIDE_MAX_PX = 8192
# deck-pdf: pdf-export.ts DECK_PAGE_SIZE (inches); preferCSSPageSize makes the deck's @page win.
DECK_PAGE_INCHES = (13.333333, 7.5)
PRINTABLE_WAIT_BUDGET_MS = 15_000
ARTIFACT_LOAD_TIMEOUT_S = 15.0
GOOGLE_FONT_STYLESHEET_TIMEOUT_S = 10.0
MAX_CDP_MESSAGE = 512 * 1024 * 1024
LAYERED_CAPTURE_ATTEMPTS = 3


class ExportError(Exception):
    """A failure the person can be told about; ``code`` is stable for callers."""

    def __init__(self, message: str, code: str = "RENDER_FAILED") -> None:
        super().__init__(message)
        self.code = code


# ---------------------------------------------------------------------------------------------
# Locating things
# ---------------------------------------------------------------------------------------------


def load_cdp_module() -> Any:
    """Load ``nova-page-browser`` (a script, not a package) to reuse its CdpClient."""
    candidates = [os.environ.get("NOVA_PAGE_BROWSER", ""), shutil.which("nova-page-browser") or ""]
    candidates.append(str(HERE / "nova-page-browser"))
    for candidate in candidates:
        if candidate and Path(candidate).is_file():
            loader = importlib.machinery.SourceFileLoader("nova_page_browser", candidate)
            spec = importlib.util.spec_from_loader("nova_page_browser", loader)
            assert spec is not None
            module = importlib.util.module_from_spec(spec)
            loader.exec_module(module)
            return module
    raise ExportError("nova-page-browser is not installed", "NO_CDP_CLIENT")


def find_chromium() -> str:
    override = os.environ.get("NOVA_DECK_CHROME")
    if override:
        return override
    for name in ("chromium", "chromium-browser", "google-chrome", "google-chrome-stable"):
        found = shutil.which(name)
        if found:
            return found
    mac = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
    if Path(mac).is_file():
        return mac
    raise ExportError("Chromium is not installed on this computer", "NO_BROWSER")


def find_asset(env: str, names: list[str]) -> Path:
    """The first existing file: the env override, then next to this script, then the image path."""
    candidates: list[Path] = []
    if os.environ.get(env):
        candidates.append(Path(os.environ[env]))
    for name in names:
        candidates.append(HERE / "deck-export" / name)
        candidates.append(Path("/usr/local/share/nova/deck-export") / name)
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    raise ExportError(f"missing export asset: {names[0]}", "NO_ASSET")


def read_bundle() -> str:
    """The vendored dom-to-pptx browser bundle (decompressed at image build, or the .gz)."""
    try:
        return find_asset("NOVA_DOM_TO_PPTX", ["dom-to-pptx.bundle.js"]).read_text("utf-8")
    except ExportError:
        gz = find_asset("NOVA_DOM_TO_PPTX_GZ", ["vendor/dom-to-pptx/dom-to-pptx.bundle.js.gz"])
        import gzip

        return gzip.decompress(gz.read_bytes()).decode("utf-8")


def page_script() -> str:
    """``deck-capture-page.js`` (an ES module) as a script that sets ``window.__novaDeck``."""
    source = find_asset("NOVA_DECK_PAGE_JS", ["deck-capture-page.js"]).read_text("utf-8")
    names = re.findall(r"^export\s+(?:async\s+)?(?:function|const)\s+([A-Za-z0-9_]+)", source, re.M)
    body = re.sub(r"^export\s+", "", source, flags=re.M)
    return f"window.__novaDeck = (function () {{\n{body}\nreturn {{ {', '.join(names)} }};\n}})();"


# ---------------------------------------------------------------------------------------------
# Chromium over CDP
# ---------------------------------------------------------------------------------------------


class Chromium:
    """A throwaway headless Chromium with its own profile, driven over one CDP connection."""

    def __init__(self) -> None:
        self.cdp = load_cdp_module()
        self.profile = Path(tempfile.mkdtemp(prefix="nova-deck-"))
        self.proc: subprocess.Popen[bytes] | None = None
        self.client: Any = None
        self.session: str = ""

    def __enter__(self) -> Chromium:
        try:
            return self._start()
        except BaseException:
            self.__exit__()
            raise

    def _start(self) -> Chromium:
        flags = [
            "--headless=new",
            "--no-sandbox",
            "--disable-gpu",
            "--disable-dev-shm-usage",
            "--hide-scrollbars",
            "--mute-audio",
            "--no-first-run",
            "--no-default-browser-check",
            "--disable-background-networking",
            "--disable-extensions",
            "--force-device-scale-factor=1",
            "--window-size=1920,1080",
            "--remote-debugging-address=127.0.0.1",
            "--remote-debugging-port=0",
            f"--user-data-dir={self.profile}",
            "about:blank",
        ]
        self.proc = subprocess.Popen(
            [find_chromium(), *flags],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        port = self._wait_for_port()
        ws_url = self.cdp.discover_ws_url(port)
        self.client = self.cdp.CdpClient(ws_url)
        self.client.max_frame_bytes = MAX_CDP_MESSAGE
        self.client.connect()
        target = self.client.call("Target.createTarget", {"url": "about:blank"})
        attached = self.client.call(
            "Target.attachToTarget", {"targetId": target["targetId"], "flatten": True}
        )
        self.session = attached["sessionId"]
        self.send("Page.enable")
        return self

    def __exit__(self, *_exc: object) -> None:
        if self.client is not None:
            self.client.close()
        if self.proc is not None:
            try:
                os.killpg(self.proc.pid, signal.SIGTERM)
            except OSError:
                pass
            try:
                self.proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(self.proc.pid, signal.SIGKILL)
                except OSError:
                    pass
        shutil.rmtree(self.profile, ignore_errors=True)

    def _wait_for_port(self) -> int:
        """Chromium writes the chosen debug port to ``DevToolsActivePort`` in its profile."""
        marker = self.profile / "DevToolsActivePort"
        deadline = time.time() + 20
        while time.time() < deadline:
            if self.proc is not None and self.proc.poll() is not None:
                raise ExportError("Chromium exited before it was ready", "NO_BROWSER")
            if marker.is_file():
                first = marker.read_text().splitlines()[:1]
                if first and first[0].isdigit():
                    return int(first[0])
            time.sleep(0.1)
        raise ExportError("Chromium did not start in time", "NO_BROWSER")

    def send(self, method: str, params: dict[str, Any] | None = None, timeout_s: float = 60.0) -> dict[str, Any]:
        return self.client.call(method, params or {}, session_id=self.session, timeout_s=timeout_s)

    def evaluate(self, expression: str, timeout_s: float = 60.0) -> Any:
        result = self.send(
            "Runtime.evaluate",
            {"expression": expression, "returnByValue": True, "awaitPromise": True},
            timeout_s=timeout_s,
        )
        details = result.get("exceptionDetails")
        if details:
            text = (details.get("exception") or {}).get("description") or details.get("text")
            raise ExportError(f"page script failed: {str(text)[:400]}")
        return (result.get("result") or {}).get("value")

    def call_page(self, name: str, *args: Any, timeout_s: float = 60.0) -> Any:
        """Call a function of ``window.__novaDeck`` with JSON-encoded arguments."""
        rendered = ", ".join(json.dumps(a) for a in args)
        return self.evaluate(f"window.__novaDeck.{name}({rendered})", timeout_s=timeout_s)

    def set_viewport(self, width: int, height: int) -> None:
        self.send(
            "Emulation.setDeviceMetricsOverride",
            {"width": width, "height": height, "deviceScaleFactor": 1, "mobile": False},
        )

    def load_document(self, html_path: Path) -> None:
        """Open the deck without letting one stalled subresource block the export.

        deck-capture.ts `loadArtifactDocument`: dom-ready (parsed and scriptable) is the signal we
        need; waiting for every subresource is `waitForPrintableContent`'s bounded job.
        """
        result = self.send("Page.navigate", {"url": html_path.resolve().as_uri()}, timeout_s=30)
        if result.get("errorText"):
            raise ExportError(f"could not open the deck: {result['errorText']}")
        deadline = time.time() + ARTIFACT_LOAD_TIMEOUT_S
        while time.time() < deadline:
            state = self.evaluate("document.readyState")
            if state in ("interactive", "complete"):
                return
            time.sleep(0.1)

    def wait_for_printable_content(self) -> None:
        """pdf-export.ts `waitForPrintableContent`: fonts, images and CSS images, bounded."""
        self.install_page_script()
        stalled = False
        try:
            outcome = self.evaluate(
                f"window.__novaDeck.waitForPrintableContentInPage({PRINTABLE_WAIT_BUDGET_MS})",
                timeout_s=PRINTABLE_WAIT_BUDGET_MS / 1000 + 5,
            )
            stalled = bool(isinstance(outcome, dict) and outcome.get("stalled"))
        except (TimeoutError, ExportError):
            stalled = True
        if stalled:
            # Cancel the requests we stopped waiting for so the renderer is handed back.
            try:
                self.send("Page.stopLoading", timeout_s=5)
            except Exception:  # noqa: BLE001
                pass

    def install_page_script(self) -> None:
        if not self.evaluate("typeof window.__novaDeck === 'object'"):
            self.evaluate(page_script())

    def next_frames(self) -> None:
        self.call_page("nextFrames")


