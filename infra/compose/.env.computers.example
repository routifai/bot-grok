# Computers VPS settings for infra/compose/docker-compose.computers.yml.
# Copy to .env.computers (never commit it). infra/compose/setup-computers-vps.sh writes it for you.

# DNS name that points at this VM; Caddy gets its TLS certificate for it. Without a domain,
# <ip-with-dashes>.sslip.io works (for example 203-0-113-7.sslip.io).
COMPUTERS_HOST=computers.example.com

# Bearer token the engine sends on every /computers request. Same value as the engine's
# OMNIGENT_COMPUTER_SUPERVISOR_TOKEN. Generate with: openssl rand -hex 32
SANDBOX_SUPERVISOR_TOKEN=

# Group id of the host Docker socket: stat -c %g /var/run/docker.sock
DOCKER_GID=

# Per-Computer ceilings. "0", "none" or "unlimited" removes one.
NOVA_COMPUTER_MEMORY=2g
NOVA_COMPUTER_CPUS=2
NOVA_COMPUTER_PIDS_LIMIT=2048
