# Copy to .env next to this file, or just run ./scripts/setup.sh — it creates .env from this
# template and fills every blank secret below with `openssl rand`. This is the environment for
# Omnigent's compose file plus `infra/compose/docker-compose.superchat.yaml`, the build-from-source
# Docker stack (see docs/SETUP.md).

# Postgres password (Omnigent's Postgres; POSTGRES_USER and POSTGRES_DB default to omnigent). It
# stays on the internal network only. Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# Override only if 5173 is already taken on your machine (the engine serves the web there).
SUPERCHAT_WEB_PORT=

# The Docker socket the engine starts each person's Computer with, as seen inside the Docker VM.
# Blank = /var/run/docker.sock (Docker Desktop, colima and native Linux); set only for e.g.
# rootless Docker.
DOCKER_SOCKET_PATH=

# Per-Computer resource ceilings. Defaults: 2g memory, 2 CPUs, 2048 pids.
COMPUTER_MEMORY=
COMPUTER_CPUS=
COMPUTER_PIDS_LIMIT=

# Model keys for the engine. Set one and nobody is asked to connect a model in the app.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Omnigent engine (the `omnigent` service; runs every chat and serves the web). The proxy secret
# lets a sign-in broker in front of the engine name the person: openssl rand -hex 32.
OMNIGENT_PROXY_SECRET=
# Seals saved model keys. 32 random bytes, base64url:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
OMNIGENT_VAULT_KEY=
# Where each Computer reaches the engine. Blank = http://host.docker.internal:<engine port>. On
# native Linux use the Docker bridge address, e.g. http://172.17.0.1:8012, and bind the engine
# there (SUPERCHAT_ENGINE_BIND=172.17.0.1).
ENGINE_PUBLIC_URL=
SUPERCHAT_ENGINE_PORT=
SUPERCHAT_ENGINE_BIND=

# LiteLLM: set both to send every model call through an existing proxy (a company gateway); the
# engine then uses its LiteLLM config instead of the Anthropic key. Root URL without /v1,
# reachable from the engine container (a host address, not a compose service name).
LITELLM_BASE_URL=
# The proxy key. It stays in the engine; models are picked in Settings > Models.
LITELLM_API_KEY=

# Image builds. Unset = public defaults. Behind a company firewall, point them at approved
# mirrors (a company CA goes in as a build secret: see docs/SETUP.md). UBUNTU_IMAGE is the Computer's
# base (ubuntu:24.04); CHROMIUM_IMAGE is the image its Chromium is copied out of (Playwright's,
# pinned in the Computer's Dockerfile). NODE_IMAGE and PYTHON_IMAGE are the engine's bases
# (node:22-slim, python:3.12-slim). TORCH_INDEX_URL is where the engine's CPU-only torch comes from
# (PyTorch's CPU index).
# UBUNTU_IMAGE=
# CHROMIUM_IMAGE=
# NODE_IMAGE=
# PYTHON_IMAGE=
# TORCH_INDEX_URL=
# PYPI_INDEX_URL=
# NPM_CONFIG_REGISTRY=
