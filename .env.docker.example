# Copy to .env next to this file, or just run ./scripts/setup.sh — it creates .env from this
# template and fills every blank secret below with `openssl rand`. This is the environment for
# `infra/compose/docker-compose.yml`, the build-from-source Docker stack (see docs/SETUP.md).

# Postgres role. Compose keeps Postgres on the internal network only (not published on the host).
# Generate with: openssl rand -hex 16
POSTGRES_USER=superchat
POSTGRES_PASSWORD=
POSTGRES_DB=superchat_db

# Public origin the browser uses. Defaults are correct for a local laptop install; change all
# three together if you put a reverse proxy or a different hostname in front of :5173.
BETTER_AUTH_URL=http://127.0.0.1:5173
WEB_ORIGIN=http://127.0.0.1:5173
API_URL=http://127.0.0.1:5173
SUPERCHAT_HOST=localhost
# Override only if 3100 or 5173 are already taken on your machine.
SUPERCHAT_API_PORT=
SUPERCHAT_WEB_PORT=

# Independent long random secrets — never reuse one value across these. Generate each with:
# openssl rand -hex 32
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
SCREEN_PROXY_SECRET=
# Distinct from BETTER_AUTH_SECRET. Required for local Docker computers (the sandbox supervisor).
SANDBOX_SUPERVISOR_TOKEN=

# closed | invite | domain | approval | open. Seeds the stored setting on first start; the
# deployment owner edits it later. Every mode except closed needs email delivery (SMTP_URL, or
# EMAIL_API_URL + EMAIL_API_KEY) on a hosted deployment. The first account becomes the owner.
# A personal install on this machine can set AUTH_ALLOW_UNVERIFIED_EMAIL=true instead.
SIGNUP_MODE=open
SIGNUP_ALLOWLIST=
SIGNUP_DOMAINS=

# docker = local computer containers via the in-stack supervisor (default, no cloud account
# needed). Optional remote providers: e2b, daytona, createos, box (see docs/self-host.md).
SANDBOX_PROVIDER=docker

# Host Docker socket for the sandbox supervisor. ./scripts/setup.sh detects this for you:
#   Docker Desktop (macOS/Windows) and native Linux Engine: /var/run/docker.sock (leave blank)
#   colima:                                                  $HOME/.colima/default/docker.sock
DOCKER_SOCKET_PATH=

# Per-bot-computer resource ceilings. Defaults: 2g memory, 2 CPUs, 2048 pids. "0" removes a ceiling.
SUPERCHAT_COMPUTER_MEMORY=
SUPERCHAT_COMPUTER_CPUS=
SUPERCHAT_COMPUTER_PIDS_LIMIT=

# The model Superchat uses. Set one of these and nobody is asked to connect a model in the app.
# PI_DEFAULT_PROVIDER picks which: openrouter | anthropic | local. PI_DEFAULT_MODEL is optional.
PI_DEFAULT_PROVIDER=openrouter
PI_DEFAULT_MODEL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Your own OpenAI-compatible server (LiteLLM, vLLM, Ollama, LM Studio): PI_DEFAULT_PROVIDER=local.
# From inside Docker, a server on this machine is http://host.docker.internal:<port>/v1.
SUPERCHAT_LOCAL_MODELS_URL=
# Comma-separated model ids exactly as the server names them; the first is the default.
SUPERCHAT_LOCAL_MODELS=
# Only if the server needs a key (e.g. a LiteLLM virtual key or master key).
SUPERCHAT_LOCAL_MODELS_API_KEY=
# Of those models, the ones that accept images (so Superchat can see its computer's screen).
SUPERCHAT_LOCAL_VISION_MODELS=

# Optional app-integration catalog (Composio). Leave blank if unused.
COMPOSIO_API_KEY=

# Omnigent engine (the `engine` service; runs every chat). OMNIGENT_URL is blank for it, or an
# external engine's URL. The proxy secret signs API -> engine calls: openssl rand -hex 32.
OMNIGENT_URL=
OMNIGENT_PROXY_SECRET=
# Seals saved model keys. 32 random bytes, base64url:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
OMNIGENT_VAULT_KEY=
# Where each Computer reaches the engine. Blank = http://host.docker.internal:<engine port>. On
# native Linux use the Docker bridge address, e.g. http://172.17.0.1:8012, and bind the engine
# there (SUPERCHAT_ENGINE_BIND=172.17.0.1).
ENGINE_PUBLIC_URL=
SUPERCHAT_ENGINE_PORT=
SUPERCHAT_ENGINE_BIND=
# Optional web search for the Muse.
TAVILY_API_KEY=

# LiteLLM (docker-compose.litellm.yml: an existing proxy; docker-compose.litellm-local.yml: a
# local one on port 4000). Root URL without /v1, reachable from the host's containers.
LITELLM_BASE_URL=
# The proxy key (a virtual key, or the local proxy's master key: starts with sk-). It stays in
# the engine; models are picked in Settings > Models.
LITELLM_API_KEY=

# Structured logs to stdout. debug | info | warn | error | off.
LOG_LEVEL=info

# Image builds. Commented out = the public defaults: Ubuntu 24.04 and the official Node image
# (both pinned by digest in the Dockerfiles), the public Ubuntu archive, npm, PyPI and Playwright's
# CDN. Behind a company firewall, uncomment and point them at your internal registry and mirrors
# (an uncommented empty value is passed as empty, not as the default).
# BASE_IMAGE / NODE_IMAGE: full image references (name:tag@sha256:digest) in your registry.
# APT_MIRROR: replaces every URIs: line of Ubuntu's apt sources (main archive and security).
# BASE_IMAGE=
# NODE_IMAGE=
# APT_MIRROR=
# NPM_CONFIG_REGISTRY=
# PYPI_INDEX_URL=
# PLAYWRIGHT_DOWNLOAD_HOST=
