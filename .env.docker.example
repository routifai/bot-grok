# Copy to .env next to this file, or just run ./scripts/setup.sh — it creates .env from this
# template and fills every blank secret below with `openssl rand`. This is the environment for
# `infra/compose/docker-compose.yml`, the build-from-source Docker stack (see docs/SETUP.md).

# Muse edition: one personal Muse per person, with Goals, Asks and a Feed. This is the default
# for this fork; leave it as-is unless you specifically want upstream Aiden's multi-bot behavior.
AIDEN_PRODUCT_MODE=muse

# Postgres role. Compose keeps Postgres on the internal network only (not published on the host).
# Generate with: openssl rand -hex 16
POSTGRES_USER=aiden
POSTGRES_PASSWORD=
POSTGRES_DB=aiden

# Public origin the browser uses. Defaults are correct for a local laptop install; change all
# three together if you put a reverse proxy or a different hostname in front of :5173.
BETTER_AUTH_URL=http://127.0.0.1:5173
WEB_ORIGIN=http://127.0.0.1:5173
API_URL=http://127.0.0.1:5173
AIDEN_HOST=localhost
# Override only if 3100 or 5173 are already taken on your machine.
AIDEN_API_PORT=
AIDEN_WEB_PORT=

# Independent long random secrets — never reuse one value across these. Generate each with:
# openssl rand -hex 32
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
SCREEN_PROXY_SECRET=
# Distinct from BETTER_AUTH_SECRET. Required for local Docker computers (the sandbox supervisor).
SANDBOX_SUPERVISOR_TOKEN=

SIGNUPS_ENABLED=true
# Empty keeps signups open to anyone who reaches this instance. The first account to register
# becomes the deployment owner.
SIGNUP_ALLOWLIST=

# docker = local computer containers via the in-stack supervisor (default, no cloud account
# needed). Optional remote providers: e2b, daytona, createos, box (see docs/self-host.md).
SANDBOX_PROVIDER=docker

# Host Docker socket for the sandbox supervisor. ./scripts/setup.sh detects this for you:
#   Docker Desktop (macOS/Windows) and native Linux Engine: /var/run/docker.sock (leave blank)
#   colima:                                                  $HOME/.colima/default/docker.sock
DOCKER_SOCKET_PATH=

# Per-bot-computer resource ceilings. Defaults: 2g memory, 2 CPUs, 2048 pids. "0" removes a ceiling.
AIDEN_COMPUTER_MEMORY=
AIDEN_COMPUTER_CPUS=
AIDEN_COMPUTER_PIDS_LIMIT=

# Optional deployment-wide model key. Leave blank to connect a model per-account from the UI
# instead (onboarding, or Settings -> Models) — that path needs nothing set here.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
PI_DEFAULT_PROVIDER=openrouter

# Optional app-integration catalog (Composio). Leave blank if unused.
COMPOSIO_API_KEY=

# Structured logs to stdout. debug | info | warn | error | off.
LOG_LEVEL=info
