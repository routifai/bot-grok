# Copy to .env next to this file, or just run ./scripts/setup.sh — it creates .env from this
# template and fills every blank secret below with `openssl rand`. This is the environment for
# Omnigent's compose file plus `infra/compose/docker-compose.superchat.yaml`, the build-from-source
# Docker stack (see docs/SETUP.md).

# Postgres password (Omnigent's Postgres; POSTGRES_USER and POSTGRES_DB default to omnigent). It
# stays on the internal network only. Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# Public origin the browser uses. Defaults are correct for a local laptop install; change all
# three together if you put a reverse proxy or a different hostname in front of :5173.
BETTER_AUTH_URL=http://127.0.0.1:5173
WEB_ORIGIN=http://127.0.0.1:5173
API_URL=http://127.0.0.1:5173
SUPERCHAT_HOST=localhost
# Override only if 3100 or 5173 are already taken on your machine.
SUPERCHAT_WEB_PORT=

# Independent long random secrets — never reuse one value across these. Generate each with:
# openssl rand -hex 32
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=

# closed | invite | domain | approval | open. Seeds the stored setting on first start; the
# deployment owner edits it later. The first account becomes the owner.
SIGNUP_MODE=open
# Sign up with email and password only, no emailed code. Set false once email delivery is
# configured (SMTP_URL, or EMAIL_API_URL + EMAIL_API_KEY) to make people confirm their address.
AUTH_ALLOW_UNVERIFIED_EMAIL=true
SIGNUP_ALLOWLIST=
SIGNUP_DOMAINS=

# The Docker socket the engine starts each person's Computer with, as seen inside the Docker VM.
# Blank = /var/run/docker.sock (Docker Desktop, colima and native Linux); set only for e.g.
# rootless Docker.
DOCKER_SOCKET_PATH=

# Per-Computer resource ceilings. Defaults: 2g memory, 2 CPUs, 2048 pids.
COMPUTER_MEMORY=
COMPUTER_CPUS=
COMPUTER_PIDS_LIMIT=

# The model Superchat uses. Set one of these and nobody is asked to connect a model in the app.
# PI_DEFAULT_PROVIDER picks which: openrouter | anthropic | local. PI_DEFAULT_MODEL is optional.
PI_DEFAULT_PROVIDER=openrouter
PI_DEFAULT_MODEL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Your own OpenAI-compatible server (LiteLLM, vLLM, Ollama, LM Studio): PI_DEFAULT_PROVIDER=local.
# From inside Docker, a server on this machine is http://host.docker.internal:<port>/v1.
SUPERCHAT_LOCAL_MODELS_URL=
# Comma-separated model ids exactly as the server names them; the first is the default.
SUPERCHAT_LOCAL_MODELS=
# Only if the server needs a key (e.g. a LiteLLM virtual key or master key).
SUPERCHAT_LOCAL_MODELS_API_KEY=
# Of those models, the ones that accept images (so Superchat can see its computer's screen).
SUPERCHAT_LOCAL_VISION_MODELS=

# Optional app-integration catalog (Composio). Leave blank if unused.
COMPOSIO_API_KEY=

# Omnigent engine (the `omnigent` service; runs every chat). OMNIGENT_URL is blank for it, or an
# external engine's URL. The proxy secret signs API -> engine calls: openssl rand -hex 32.
OMNIGENT_URL=
OMNIGENT_PROXY_SECRET=
# Seals saved model keys. 32 random bytes, base64url:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
OMNIGENT_VAULT_KEY=
# Where each Computer reaches the engine. Blank = http://host.docker.internal:<engine port>. On
# native Linux use the Docker bridge address, e.g. http://172.17.0.1:8012, and bind the engine
# there (SUPERCHAT_ENGINE_BIND=172.17.0.1).
ENGINE_PUBLIC_URL=
SUPERCHAT_ENGINE_PORT=
SUPERCHAT_ENGINE_BIND=

# LiteLLM: set both to send every model call through an existing proxy (a company gateway); the
# engine then uses its LiteLLM config instead of the Anthropic key. Root URL without /v1,
# reachable from the engine container (a host address, not a compose service name).
LITELLM_BASE_URL=
# The proxy key. It stays in the engine; models are picked in Settings > Models.
LITELLM_API_KEY=

# Structured logs to stdout. debug | info | warn | error | off.
LOG_LEVEL=info

# Image builds. Unset = public defaults. Behind a company firewall, point them at approved
# mirrors (a company CA goes in as a build secret: see docs/SETUP.md). UBUNTU_IMAGE is the Computer's
# base (ubuntu:24.04); CHROMIUM_IMAGE is the image its Chromium is copied out of (Playwright's,
# pinned in the Computer's Dockerfile). NODE_IMAGE and PYTHON_IMAGE are the engine's bases
# (node:22-slim, python:3.12-slim). TORCH_INDEX_URL is where the engine's CPU-only torch comes from
# (PyTorch's CPU index).
# UBUNTU_IMAGE=
# CHROMIUM_IMAGE=
# NODE_IMAGE=
# PYTHON_IMAGE=
# TORCH_INDEX_URL=
# PYPI_INDEX_URL=
# NPM_CONFIG_REGISTRY=
