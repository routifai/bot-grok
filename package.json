{
  "name": "superchat",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.22.2 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "cross-env COREPACK_ENABLE_DOWNLOAD_PROMPT=0 pnpm --filter @superchat/web dev",
    "generate": "pnpm --filter @superchat/ui-tokens generate",
    "build": "pnpm generate && pnpm -r build",
    "check": "pnpm generate && pnpm -r check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "host:build": "docker compose --env-file .env -f deployment/compose.yaml build host",
    "test": "vitest run",
    "compose:up": "docker compose --env-file .env -f deployment/compose.yaml up --build",
    "compose:down": "docker compose --env-file .env -f deployment/compose.yaml down -v"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "24.13.3",
    "cross-env": "10.1.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    },
    "patchedDependencies": {
      "@aiden0z/pptx-renderer@1.3.0": "patches/@aiden0z__pptx-renderer@1.3.0.patch"
    }
  }
}
