{
  "name": "nova",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.22.2 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "cross-env COREPACK_ENABLE_DOWNLOAD_PROMPT=0 turbo dev --filter=@nova/api --filter=@nova/worker --filter=@nova/web --filter=@nova/sandbox-supervisor",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @nova/db generate",
    "db:migrate": "pnpm --filter @nova/db migrate",
    "sandbox:build": "docker build -t nova/computer:local -f infra/sandboxes/computer/Dockerfile .",
    "test": "vitest run",
    "test:compose-smoke": "bash infra/compose/run-smokes.sh",
    "test:integration": "tsx packages/testkit/src/cli/harness.ts --integration",
    "test:e2e": "tsx packages/testkit/src/cli/harness.ts --e2e",
    "test:mobile-screenshots": "pnpm --filter @nova/db generate && tsx packages/testkit/src/cli/mobile-screenshots.ts",
    "test:topology": "tsx packages/testkit/src/cli/topology.ts",
    "test:canary": "tsx packages/testkit/src/cli/canary.ts",
    "perf:desktop": "tsx packages/testkit/src/cli/desktop-performance.ts",
    "perf:compare": "tsx packages/testkit/src/cli/compare-performance.ts",
    "compose:up": "docker compose --env-file .env -f infra/compose/docker-compose.yml up --build",
    "compose:down": "docker compose --env-file .env -f infra/compose/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "24.13.3",
    "cross-env": "10.1.0",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    },
    "patchedDependencies": {
      "app-builder-lib@26.15.3": "patches/app-builder-lib@26.15.3.patch"
    }
  }
}
